export global Theme {
    in property <color> bg: #12141a;
    in property <color> bg-elevated: #1a1e28;
    in property <color> fg: #e8ecf4;
    in property <color> fg-muted: #9aa3b5;
    in property <color> accent: #3d8bfd;
    in property <color> accent-hover: #5a9fff;
    in property <color> danger: #e35d6a;
    in property <length> radius: 8px;
    in property <length> pad: 12px;
}
